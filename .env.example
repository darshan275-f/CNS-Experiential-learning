# Server
PORT=3000
NODE_ENV=development

# Master secret used to derive server-side pepper for scrypt (never commit real values)
ENCRYPTION_PEPPER=change-this-to-a-long-random-string-in-production

# PBKDF2/scrypt tuning
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_KEYLEN=32
SCRYPT_SALT_BYTES=16

# Upload limits
MAX_UPLOAD_BYTES=10485760
UPLOAD_DIR=src/uploads

# JWT (optional API protection)
JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRES_IN=1h
REQUIRE_JWT=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
